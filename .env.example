# Copy to .env (never commit .env) or export these variables in your shell.
# The project uses AvalAI (OpenAI-compatible API), as the assignment requires.
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_MODEL=gpt-4o-mini

# Optional, development only: call OpenAI directly instead of AvalAI.
# An OPENAI_API_KEY is ignored unless LLM_PROVIDER=openai is set.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
