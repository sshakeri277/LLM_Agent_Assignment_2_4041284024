# Copy to .env (never commit .env) or export these variables in your shell.
# Set ONE of the two keys. AvalAI is used when AVALAI_API_KEY is set; otherwise OpenAI directly.

# --- AvalAI (OpenAI-compatible) ---
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_MODEL=gpt-4o-mini

# --- or OpenAI directly ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
